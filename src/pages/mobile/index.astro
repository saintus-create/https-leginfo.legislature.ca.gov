---
const base = import.meta.env.BASE_URL;
const home = `${base.endsWith('/') ? base : `${base}/`}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${home}`} />
    <title>California Legislative Information</title>
  </head>
  <body>
    <p>This site is responsive and does not require a separate mobile URL.</p>
    <p><a href={home}>Continue to California Legislative Information</a></p>
  </body>
</html>
