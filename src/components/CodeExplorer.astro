---
const codes=[['BPC','Business and Professions Code'],['CIV','Civil Code'],['CCP','Code of Civil Procedure'],['COM','Commercial Code'],['CORP','Corporations Code'],['EDC','Education Code'],['ELEC','Elections Code'],['EVID','Evidence Code'],['FAM','Family Code'],['FIN','Financial Code'],['FGC','Fish and Game Code'],['FAC','Food and Agricultural Code'],['GOV','Government Code'],['HNC','Harbors and Navigation Code'],['HSC','Health and Safety Code'],['INS','Insurance Code'],['LAB','Labor Code'],['MVC','Military and Veterans Code'],['PCC','Penal Code'],['PROB','Probate Code'],['PUC','Public Utilities Code'],['RTC','Revenue and Taxation Code'],['SHC','Streets and Highways Code'],['UIC','Unemployment Insurance Code'],['VEH','Vehicle Code'],['WAT','Water Code'],['WIC','Welfare and Institutions Code'],['CONS','California Constitution']];
const base=import.meta.env.BASE_URL;const publicChat='https://5f679b75-e58c-4cbd-8350-b2c83df8f361.search.ai.cloudflare.com/chat/completions';
---
<div class="law-explorer" data-base={base} data-chat={publicChat}><section class="research-panel"><div class="eyebrow">California Legislative Research</div><h2>Ask a legal question</h2><p>Ask in ordinary language. The research engine identifies authorities, compares provisions, follows relationships, and explains the evidence.</p><form data-research-form><input data-research-query type="search" placeholder="What do Family Code and Government Code have in common?" required/><button>Research</button></form><div data-research-status class="status">Ready.</div><article data-research-answer class="answer" hidden></article></section>
<section><h2>Browse the corpus</h2><p>Exact section and text lookup across all published codes.</p><div class="toolbar"><label>Code<select data-code-select>{codes.map(([a,n])=><option value={a}>{a} — {n}</option>)}</select></label><label>Find<input data-law-query type="search" placeholder="e.g. 300 or custody"/></label></div><div data-law-status class="status">Loading…</div><div data-law-results></div></section></div>
<script>
interface Law{uid?:string;kind?:string;section?:string;citation?:string;text?:string;path?:string;history?:string}interface R{answer?:string;state?:{intent?:string;findings?:Array<{citation?:string;lawCode?:string;sectionNum?:string;text?:string}>;unresolved?:string[]}}interface C{choices?:Array<{message?:{content?:string}}>;answer?:string;response?:string}
const esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]??c));document.querySelectorAll<HTMLElement>('.law-explorer').forEach(root=>{const base=(root.dataset.base||'/').replace(/\/?$/,'/'),chat=root.dataset.chat!,form=root.querySelector<HTMLFormElement>('[data-research-form]')!,input=root.querySelector<HTMLInputElement>('[data-research-query]')!,status=root.querySelector<HTMLElement>('[data-research-status]')!,answer=root.querySelector<HTMLElement>('[data-research-answer]')!,select=root.querySelector<HTMLSelectElement>('[data-code-select]')!,q=root.querySelector<HTMLInputElement>('[data-law-query]')!,ls=root.querySelector<HTMLElement>('[data-law-status]')!,lr=root.querySelector<HTMLElement>('[data-law-results]')!;let records:Law[]=[];
function renderAnswer(d:R){answer.innerHTML=`<div class="answer-text">${esc(d.answer||'No generated answer returned.')}</div>${d.state?.findings?.length?`<details><summary>Evidence (${d.state.findings.length})</summary>${d.state.findings.slice(0,30).map(x=>`<div class="evidence"><strong>${esc(x.citation||`${x.lawCode||''} § ${x.sectionNum||''}`)}</strong><div>${esc(x.text)}</div></div>`).join('')}</details>`:''}${d.state?.unresolved?.length?`<details><summary>Limits</summary>${d.state.unresolved.map(x=>`<div>${esc(x)}</div>`).join('')}</details>`:''}`;answer.hidden=false;status.textContent=`Research complete · ${d.state?.intent||'research'}`}
async function research(text:string){status.textContent='Researching…';answer.hidden=true;try{const r=await fetch('/api/research',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({query:text})});if(r.ok){renderAnswer(await r.json() as R);return}const x=await fetch(chat,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({messages:[{role:'user',content:text}]})});if(!x.ok)throw Error(`AI Search HTTP ${x.status}`);const d=await x.json() as C;renderAnswer({answer:d.choices?.[0]?.message?.content||d.answer||d.response||'',state:{intent:'ai-search'}})}catch(e){status.textContent=`Research unavailable: ${e instanceof Error?e.message:String(e)}`}}
function render(){const x=q.value.trim().toLowerCase(),m=x?records.filter(r=>`${r.section||''} ${r.citation||''} ${r.text||''} ${r.path||''}`.toLowerCase().includes(x)):records;ls.textContent=`${m.length.toLocaleString()} matching sections.`;lr.innerHTML=m.slice(0,100).map(r=>`<article class="law-section"><strong>${esc(r.citation||r.section)}</strong>${r.path?`<div class="path">${esc(r.path)}</div>`:''}<div class="law-text">${esc(r.text||'')}</div>${r.history?`<details><summary>History</summary>${esc(r.history)}</details>`:''}</article>`).join('')}
async function load(code:string){records=[];lr.innerHTML='';ls.textContent=`Loading ${code}…`;try{const m=await (await fetch(`${base}data/law/manifest.json`)).json() as Record<string,string[]>;const chunks=m[code];if(!chunks?.length)throw Error(`No ${code} data`);const rr=await Promise.all(chunks.map(c=>fetch(`${base}data/law/${encodeURIComponent(c)}`)));const text=(await Promise.all(rr.map(x=>x.text()))).join('');records=text.split('\n').filter(Boolean).map(x=>JSON.parse(x) as Law).filter(x=>x.kind==='section');render()}catch(e){ls.textContent=`Could not load ${code}: ${e instanceof Error?e.message:String(e)}`}}form.addEventListener('submit',e=>{e.preventDefault();const x=input.value.trim();if(x)research(x)});select.addEventListener('change',()=>load(select.value));q.addEventListener('input',render);load(select.value)});
</script>
<style>.research-panel{padding:1.5rem 1.25rem 2rem;margin-bottom:2rem;background:color-mix(in srgb,var(--sl-color-accent-low) 28%,var(--sl-color-bg));border-radius:.8rem}.eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--sl-color-text-accent)}.research-panel h2{margin:.25rem 0}.research-panel form{display:flex;gap:.6rem}.research-panel input{flex:1;min-width:0}.research-panel input,.research-panel button,.toolbar input,.toolbar select{padding:.7rem .8rem;border:0;border-radius:.4rem;background:var(--sl-color-bg);color:var(--sl-color-text);font:inherit}.research-panel button{background:var(--sl-color-accent);color:var(--sl-color-white);font-weight:700}.status{margin:.8rem 0;color:var(--sl-color-gray-2);font-size:.9rem}.answer-text{white-space:pre-wrap;line-height:1.7;margin:1rem 0}.evidence{border-top:1px solid var(--sl-color-gray-5);padding:.8rem 0}.evidence strong{color:var(--sl-color-text-accent)}.toolbar{display:grid;grid-template-columns:12rem 1fr;gap:1rem;margin:1.25rem 0}.toolbar label{display:grid;gap:.4rem;font-size:.8rem;font-weight:600}.law-section{border-top:1px solid var(--sl-color-gray-5);padding:1.2rem 0}.law-text{white-space:pre-wrap;line-height:1.65;margin-top:.5rem}.path{font-size:.8rem;color:var(--sl-color-gray-2)}@media(max-width:700px){.research-panel form,.toolbar{display:flex;flex-direction:column}}</style>
