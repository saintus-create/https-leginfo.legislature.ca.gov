---
const codes=[['BPC','Business and Professions Code'],['CIV','Civil Code'],['CCP','Code of Civil Procedure'],['EVID','Evidence Code'],['FAM','Family Code'],['GOV','Government Code'],['HSC','Health and Safety Code'],['LAB','Labor Code'],['PCC','Penal Code'],['PROB','Probate Code'],['WIC','Welfare and Institutions Code'],['CONS','California Constitution']];
const base=import.meta.env.BASE_URL;
const publicChat='https://5f679b75-e58c-4cbd-8350-b2c83df8f361.search.ai.cloudflare.com/chat/completions';
---
<div class="law-explorer" data-base={base} data-chat={publicChat}>
<section class="research-panel" aria-labelledby="research-heading"><div class="eyebrow">California Legislative Research</div><h2 id="research-heading">Ask a legal question</h2><p>Ask in ordinary language. The research engine identifies relevant authorities, compares provisions, follows relationships, and explains the evidence.</p><form data-research-form><input data-research-query type="search" placeholder="What do Family Code and Government Code have in common?" autocomplete="off" required/><button type="submit">Research</button></form><div data-research-status class="status" aria-live="polite">Ready.</div><article data-research-answer class="answer" hidden></article></section>
<section aria-labelledby="browse-heading"><h2 id="browse-heading">Browse the corpus</h2><p>Exact section and text lookup across the published corpus.</p><div class="toolbar"><label>Code<select data-code-select>{codes.map(([a,n])=><option value={a}>{a} — {n}</option>)}</select></label><label>Find<input data-law-query type="search" placeholder="e.g. 300 or custody" autocomplete="off"/></label></div><div data-law-status class="status">Loading…</div><div data-law-results></div></section></div>
<script>
interface Law{uid?:string;kind?:string;section?:string;citation?:string;text?:string;path?:string;history?:string} interface Research{answer?:string;state?:{intent?:string;findings?:Array<{citation?:string;lawCode?:string;sectionNum?:string;text?:string}>;unresolved?:string[]}} interface Chat{choices?:Array<{message?:{content?:string}}>;answer?:string;response?:string;chunks?:Array<{text?:string;item?:{key?:string}}>}
const esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]??c));
document.querySelectorAll<HTMLElement>('.law-explorer').forEach(root=>{const base=(root.dataset.base||'/').replace(/\/?$/,'/'),chat=root.dataset.chat||'';const form=root.querySelector<HTMLFormElement>('[data-research-form]')!,input=root.querySelector<HTMLInputElement>('[data-research-query]')!,rs=root.querySelector<HTMLElement>('[data-research-status]')!,answer=root.querySelector<HTMLElement>('[data-research-answer]')!,select=root.querySelector<HTMLSelectElement>('[data-code-select]')!,q=root.querySelector<HTMLInputElement>('[data-law-query]')!,ls=root.querySelector<HTMLElement>('[data-law-status]')!,lr=root.querySelector<HTMLElement>('[data-law-results]')!;let records:Law[]=[];
function show(data:Research){const a=data.answer||'';answer.innerHTML=`<div class="answer-text">${esc(a||'Evidence retrieved, but no generated answer was returned.')}</div>${data.state?.findings?.length?`<details><summary>Evidence (${data.state.findings.length})</summary>${data.state.findings.slice(0,30).map(s=>`<div class="evidence"><strong>${esc(s.citation||`${s.lawCode||''} § ${s.sectionNum||''}`)}</strong><div>${esc(s.text)}</div></div>`).join('')}</details>`:''}${data.state?.unresolved?.length?`<details><summary>Limits</summary>${data.state.unresolved.map(x=>`<div>${esc(x)}</div>`).join('')}</details>`:''}`;answer.hidden=false;rs.textContent=`Research complete · ${data.state?.intent||'research'}`;}
async function research(text:string){rs.textContent='Researching the statutory corpus…';answer.hidden=true;try{const r=await fetch('/api/research',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({query:text})});if(r.ok){show(await r.json() as Research);return}if(!chat)throw Error(`Research HTTP ${r.status}`);rs.textContent='Using the indexed legislative AI search…';const r2=await fetch(chat,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({messages:[{role:'user',content:text}]})});if(!r2.ok)throw Error(`AI Search HTTP ${r2.status}`);const d=await r2.json() as Chat;const content=d.choices?.[0]?.message?.content||d.answer||d.response||'';show({answer:content,state:{intent:'ai-search',findings:d.chunks?.map(c=>({citation:c.item?.key,text:c.text}))||[]}});}catch(e){rs.textContent=`Research unavailable: ${e instanceof Error?e.message:String(e)}`;}}
function render(){const x=q.value.trim().toLowerCase(),m=x?records.filter(r=>`${r.section||''} ${r.citation||''} ${r.text||''} ${r.path||''}`.toLowerCase().includes(x)):records;ls.textContent=`${m.length.toLocaleString()} matching sections.`;lr.innerHTML=m.slice(0,100).map(r=>`<article class="law-section"><strong>${esc(r.citation||r.section)}</strong>${r.path?`<div class="path">${esc(r.path)}</div>`:''}<div class="law-text">${esc(r.text||'')}</div>${r.history?`<details><summary>History</summary>${esc(r.history)}</details>`:''}</article>`).join('');}
async function load(code:string){records=[];lr.innerHTML='';ls.textContent=`Loading ${code}…`;try{const mr=await fetch(`${base}data/law/manifest.json`);if(!mr.ok)throw Error(`manifest HTTP ${mr.status}`);const manifest=await mr.json() as Record<string,string[]>;const chunks=manifest[code];if(!chunks?.length)throw Error(`No ${code} data`);const rr=await Promise.all(chunks.map(c=>fetch(`${base}data/law/${encodeURIComponent(c)}`)));if(rr.some(x=>!x.ok))throw Error('A corpus chunk failed to load');const text=(await Promise.all(rr.map(x=>x.text()))).join('');records=text.split('\n').filter(Boolean).map(x=>JSON.parse(x) as Law).filter(x=>x.kind==='section');render();}catch(e){ls.textContent=`Could not load ${code}: ${e instanceof Error?e.message:String(e)}`;}}
form.addEventListener('submit',e=>{e.preventDefault();const x=input.value.trim();if(x)research(x)});select.addEventListener('change',()=>load(select.value));q.addEventListener('input',render);load(select.value);});
</script>
<style>
.research-panel{padding:1.5rem 1.25rem 2rem;margin-bottom:2rem;background:color-mix(in srgb,var(--sl-color-accent-low) 28%,var(--sl-color-bg));border-radius:.8rem}.eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--sl-color-text-accent)}.research-panel h2{margin:.25rem 0}.research-panel p{max-width:60rem}.research-panel form{display:flex;gap:.6rem}.research-panel input{flex:1;min-width:0}.research-panel input,.research-panel button,.toolbar input,.toolbar select{padding:.7rem .8rem;border:0;border-radius:.4rem;background:var(--sl-color-bg);color:var(--sl-color-text);font:inherit}.research-panel button{background:var(--sl-color-accent);color:var(--sl-color-white);font-weight:700;cursor:pointer}.status{margin:.8rem 0;color:var(--sl-color-gray-2);font-size:.9rem}.answer{line-height:1.7}.answer-text{white-space:pre-wrap;margin:1rem 0}.answer details{margin-top:1rem}.evidence{border-top:1px solid var(--sl-color-gray-5);padding:.8rem 0}.evidence strong{color:var(--sl-color-text-accent)}.evidence div{margin-top:.3rem;white-space:pre-wrap}.toolbar{display:grid;grid-template-columns:12rem 1fr;gap:1rem;margin:1.25rem 0}.toolbar label{display:grid;gap:.4rem;font-size:.8rem;font-weight:600}.law-section{border-top:1px solid var(--sl-color-gray-5);padding:1.2rem 0}.law-text{white-space:pre-wrap;line-height:1.65;margin-top:.5rem}.path{font-size:.8rem;color:var(--sl-color-gray-2);margin-top:.3rem}@media(max-width:700px){.research-panel form,.toolbar{display:flex;flex-direction:column}}
</style>
