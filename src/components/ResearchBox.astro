---
const base = import.meta.env.BASE_URL;
const chatPublic = 'https://5f679b75-e58c-4cbd-8350-b2c83df8f361.search.ai.cloudflare.com/chat/completions';
---
<section class="research-box spotlight-shell" data-base={base} data-chat={chatPublic} data-index={`${base}data/research-index.json`} aria-labelledby="research-box-heading">
  <div class="spotlight-orb" aria-hidden="true"></div>
  <div class="hero-copy">
    <div class="eyebrow"><span class="eyebrow-pulse"></span> AI RESEARCH ENGINE — NOT KEYWORD MATCH</div>
    <h2 id="research-box-heading">Ask California law <span class="gradient-word">with evidence.</span></h2>
    <p class="subhead">AI reasoning over authoritative corpus: orchestrated retrieval, evidence graph, definition resolution, temporal history, verification. Every claim traceable to a citation.</p>
    <div class="signal-grid" aria-label="Research engine capabilities">
      <div class="signal-card"><strong>01</strong><span>Plan</span><small>Intent + scope</small></div>
      <div class="signal-card"><strong>02</strong><span>Retrieve</span><small>Hybrid evidence</small></div>
      <div class="signal-card"><strong>03</strong><span>Verify</span><small>Citation grounded</small></div>
    </div>
  </div>
  <div class="conversation" data-conversation aria-live="polite"></div>
  <form data-form>
    <input data-query type="search" placeholder="e.g. What do Family Code and Government Code have in common? Or GOV § 7921.000" autocomplete="off" required />
    <button data-send>Research</button>
  </form>
  <div class="status" data-status><span class="dot"></span><span data-status-text>Ready — AI-first research</span></div>
  <details class="capabilities"><summary>How this is strong AI, not word match</summary>
    <ul>
      <li><strong>Orchestrator</strong> parses intent (lookup/explain/compare/investigate/chronology/synthesis), extracts citations, temporal scope, concepts</li>
      <li><strong>Adaptive plan</strong>: exact section → semantic search → definition → relationships → history → evidence graph → citation resolution</li>
      <li><strong>Hybrid retrieval</strong>: D1 FTS5 BM25 + semantic AI Search + RRF fusion + query rewrite + reranking</li>
      <li><strong>Verification</strong>: draft answer then verifier removes unsupported claims</li>
      <li><strong>Citations</strong> are canonical LegInfo URLs, not internal IDs</li>
      <li>Streaming, conversation context, limits, provenance tracked</li>
    </ul>
  </details>
</section>

<script>
interface Citation { label: string; url: string; lawCode: string; sectionNum: string }
interface Finding { uid: string; lawCode: string; sectionNum: string; citation: Citation | string; title?: string; text: string; relevance: number; matchType: string }
interface Relationship { sourceUid: string; targetUid?: string; relationship: string; referenceText?: string; confidence: number }
interface HistoryEvent { id: string; uid: string; eventType: string; description?: string; effectiveDate?: string }
interface ResearchState { intent: string; codes: string[]; subjects: string[]; findings: Finding[]; definitions?: Finding[]; relationships: Relationship[]; history: HistoryEvent[]; unresolved: string[]; methods: string[]; provenance: { plannedSteps: number; executedSteps: number; durationMs: number } }
interface AnswerResponse { ok: boolean; answer: string; state: ResearchState; evidence: { results: Finding[]; relationships: Relationship[]; retrieval: { methods: string[] } }; model?: string }
interface ResearchResponse { ok: boolean; state: ResearchState; evidence: any }

type Msg = { role: 'user' | 'assistant'; content: string }

const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c));
const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));

// ── Static fallback retrieval – improved beyond word match ──
interface Index { version: number; codes: Record<string, { name: string; sectionCount: number }>; terms: Record<string, string[]>; locations: Record<string, string> }
interface RecordItem { kind?: string; uid?: string; citation?: string; title?: string; section?: string; text?: string; history?: string }

const STOP = new Set(['the','and','for','that','this','with','from','shall','may','must','such','which','into','upon','under','there','their','them','than','then','where','when','what','have','has','had','not','any','all','each','other','more','only','section','sections','code','codes','california','please','explain','describe']);

function tokenise(s: string) {
  const raw = s.toLowerCase().match(/[a-z0-9][a-z0-9._-]{2,}/g) || [];
  return [...new Set(raw.filter(x => !STOP.has(x)))].slice(0, 32);
}

function scoreRecord(rec: RecordItem, tokens: string[], phrase: string) {
  const hay = `${rec.title || ''} ${rec.text || ''}`.toLowerCase();
  let value = 0;
  for (const t of tokens) {
    const re = new RegExp(`\\b${t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`, 'g');
    const hits = (hay.match(re) || []).length;
    if (!hits) continue;
    const tf = Math.log(1 + hits);
    const titleBoost = rec.title?.toLowerCase().includes(t) ? 3 : 1;
    value += tf * titleBoost * 2;
  }
  if (phrase && hay.includes(phrase.toLowerCase())) value += 15;
  if (rec.text && rec.text.length < 80) value *= 0.5;
  return value;
}

async function parsePart(url: string): Promise<RecordItem[]> {
  const r = await fetch(url);
  if (!r.ok) throw Error(`Corpus part HTTP ${r.status}`);
  const text = await r.text();
  return text.split(/\r?\n/).filter(Boolean).flatMap(line => {
    try { const x = JSON.parse(line); return x?.kind === 'section' ? [x] : []; } catch { return []; }
  });
}

async function retrieveStatic(query: string, indexUrl: string): Promise<Finding[]> {
  const index: Index = await fetch(indexUrl).then(r => { if (!r.ok) throw Error(`Index HTTP ${r.status}`); return r.json(); });
  const tokens = tokenise(query);
  const phrase = query.replace(/\b(what|is|the|a|an|how|does|do|can|please)\b/gi, ' ').replace(/\s+/g, ' ').trim().toLowerCase();
  const wanted = new Set<string>();
  for (const t of tokens) (index.terms[t] ?? []).forEach(uid => wanted.add(uid));

  const codeNames: Record<string,string> = { BPC:'Business and Professions Code',CIV:'Civil Code',CCP:'Code of Civil Procedure',COM:'Commercial Code',CORP:'Corporations Code',EDC:'Education Code',ELEC:'Elections Code',EVID:'Evidence Code',FAM:'Family Code',FIN:'Financial Code',FGC:'Fish and Game Code',FAC:'Food and Agricultural Code',GOV:'Government Code',HNC:'Harbors and Navigation Code',HSC:'Health and Safety Code',INS:'Insurance Code',LAB:'Labor Code',MVC:'Military and Veterans Code',PEN:'Penal Code',PROB:'Probate Code',PCC:'Public Contract Code',PRC:'Public Resources Code',PUC:'Public Utilities Code',RTC:'Revenue and Taxation Code',SHC:'Streets and Highways Code',UIC:'Unemployment Insurance Code',VEH:'Vehicle Code',WAT:'Water Code',WIC:'Welfare and Institutions Code',CONS:'California Constitution' };
  const code = Object.entries(codeNames).find(([k,n]) => query.toLowerCase().includes(k.toLowerCase()) || query.toLowerCase().includes(n.toLowerCase()));

  const parts = new Set<string>();
  for (const uid of wanted) { const p = index.locations[uid]; if (p) parts.add(p); }
  if (code && !parts.size) {
    for (const uid of Object.keys(index.locations)) {
      if (uid.startsWith(`${code[0]}:`)) { const p = index.locations[uid]; if (p) parts.add(p); if (parts.size >= 6) break; }
    }
  }
  if (!parts.size) throw Error('No indexed corpus candidates.');

  const base = indexUrl.replace(/\/data\/research-index\.json$/, '/data/law/');
  const records = (await Promise.all([...parts].slice(0, 10).map(p => parsePart(`${base}${p}`)))).flat();
  const scored = records.map(x => ({ x, score: scoreRecord(x, tokens, phrase) }))
    .filter(x => x.score > 0.2)
    .sort((a,b) => b.score - a.score)
    .slice(0, 14)
    .map(({x, score}) => ({
      uid: x.uid || `${code?.[0] || 'GOV'}:${x.section}`,
      lawCode: code?.[0] || 'GOV',
      sectionNum: x.section || '',
      citation: { label: x.citation || x.uid, url: `https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?sectionNum=${encodeURIComponent(x.section || '')}.&lawCode=${code?.[0] || 'GOV'}`, lawCode: code?.[0] || 'GOV', sectionNum: x.section || '' } as any,
      title: x.title,
      text: x.text || '',
      relevance: Math.min(1, score / 20),
      matchType: 'fulltext'
    } as Finding));

  if (!scored.length) throw Error('No responsive statutory text found.');
  return scored;
}

// ── Rendering ──
function renderMessage(root: HTMLElement, user: string, answer: string, state?: ResearchState) {
  const c = root.querySelector<HTMLElement>('[data-conversation]')!;
  const userDiv = document.createElement('div');
  userDiv.className = 'message user';
  userDiv.innerHTML = `<div class="role">YOU — ${esc(state?.intent || 'question')}</div><div>${esc(user)}</div>`;
  c.append(userDiv);

  const assistantDiv = document.createElement('div');
  assistantDiv.className = 'message assistant';

  const findings = state?.findings || [];
  const definitions = state?.definitions || [];
  const relationships = state?.relationships || [];
  const history = state?.history || [];
  const methods = state?.methods || [];
  const unresolved = state?.unresolved || [];

  const citationList = findings.slice(0, 12).map(f => {
    const cit = typeof f.citation === 'string' ? { label: f.citation, url: '#', lawCode: f.lawCode, sectionNum: f.sectionNum } : f.citation as Citation;
    return `<div class="source"><strong><a href="${esc(cit.url)}" target="_blank" rel="noopener">${esc(cit.label)}</a></strong>${f.title ? `<span>${esc(f.title)}</span>` : ''}<p>${esc(f.text.slice(0, 800))}${f.text.length > 800 ? '…' : ''}</p><div class="meta">${esc(f.matchType)} · relevance ${f.relevance.toFixed(2)}</div></div>`;
  }).join('');

  const relList = relationships.slice(0, 15).map(r => `<div class="rel"><code>${esc(r.sourceUid)}</code> —${esc(r.relationship)}→ <code>${esc(r.targetUid || '')}</code> ${r.referenceText ? `<span>${esc(r.referenceText)}</span>` : ''}</div>`).join('');

  assistantDiv.innerHTML = `
    <div class="role">LEGINFO AI — ${esc(state?.intent || 'synthesis')} · ${esc(methods.slice(0,5).join(', '))}</div>
    <div class="answer">${esc(answer)}</div>
    ${findings.length ? `<details open><summary>Evidence — ${findings.length} provisions · ${state?.provenance?.executedSteps || 0} steps · ${state?.provenance?.durationMs || 0}ms</summary><div class="evidence-grid">${citationList}</div></details>` : ''}
    ${definitions.length ? `<details><summary>Definitions — ${definitions.length}</summary>${definitions.map(d => `<div class="source"><strong>${esc(typeof d.citation === 'string' ? d.citation : (d.citation as Citation).label)}</strong><p>${esc(d.text.slice(0,600))}</p></div>`).join('')}</details>` : ''}
    ${relationships.length ? `<details><summary>Statutory connections — ${relationships.length}</summary><div class="rels">${relList}</div></details>` : ''}
    ${history.length ? `<details><summary>History — ${history.length} events</summary>${history.map(h => `<div class="history"><strong>${esc(h.eventType)}</strong> ${esc(h.effectiveDate || '')} ${esc(h.description || '')}</div>`).join('')}</details>` : ''}
    ${unresolved.length ? `<details><summary>Limits — ${unresolved.length} unresolved</summary>${unresolved.map(u => `<div class="unresolved">${esc(u)}</div>`).join('')}</details>` : ''}
  `;

  c.append(assistantDiv);
  assistantDiv.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  return assistantDiv;
}

// ── Main ──
document.querySelectorAll<HTMLElement>('.research-box').forEach(root => {
  root.querySelectorAll<HTMLElement>('.signal-card').forEach(card => {
    card.addEventListener('pointermove', event => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
      card.style.setProperty('--my', `${event.clientY - rect.top}px`);
    });
  });
  const form = root.querySelector<HTMLFormElement>('[data-form]')!;
  const input = root.querySelector<HTMLInputElement>('[data-query]')!;
  const send = root.querySelector<HTMLButtonElement>('[data-send]')!;
  const status = root.querySelector<HTMLElement>('[data-status-text]')!;
  const indexUrl = root.dataset.index!;
  const history: Msg[] = [];

  form.addEventListener('submit', async e => {
    e.preventDefault();
    const query = input.value.trim();
    if (!query || send.disabled) return;
    send.disabled = true;
    status.textContent = 'Orchestrating research plan — parsing intent, citations, temporal scope…';

    try {
      // 1. Try strong AI answer endpoint
      try {
        status.textContent = 'Retrieving evidence — hybrid BM25 + AI Search RRF + definitions + relationships…';
        const r = await fetch(`/api/answer`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ query, messages: history.slice(-10), stream: false })
        });

        if (r.ok) {
          const data = await r.json() as AnswerResponse;
          if (data.answer) {
            history.push({ role: 'user', content: query }, { role: 'assistant', content: data.answer });
            renderMessage(root, query, data.answer, data.state);
            status.textContent = `Research complete — ${data.state.intent} · ${data.state.findings.length} provisions · ${data.state.methods.join(', ').slice(0, 80)} · model ${data.model || 'ai'}`;
            input.value = '';
            send.disabled = false;
            return;
          }
        } else {
          const err = await r.text();
          console.warn('answer endpoint failed', r.status, err.slice(0, 500));
        }
      } catch (err) {
        console.warn('answer endpoint error, falling back', err);
      }

      // 2. Fallback to research-only endpoint
      try {
        status.textContent = 'AI generation unavailable — retrieving evidence deterministically…';
        const r = await fetch(`/api/research`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ query, messages: history.slice(-8) })
        });
        if (r.ok) {
          const data = await r.json() as ResearchResponse;
          const fallbackAnswer = `Short answer: Retrieved ${data.state.findings.length} responsive California provisions for "${query}" (intent: ${data.state.intent}).

Evidence:
${data.state.findings.slice(0, 6).map(f => `- ${(typeof f.citation === 'string' ? f.citation : (f.citation as any).label)} — ${f.title || ''}`).join('\n')}

Connections:
${data.state.relationships.slice(0, 6).map(rel => `- ${rel.sourceUid} ${rel.relationship} ${rel.targetUid || ''}`).join('\n') || 'No explicit relationships retrieved.'}

Analysis:
The orchestrator executed ${data.state.provenance.executedSteps} of ${data.state.provenance.plannedSteps} planned steps in ${data.state.provenance.durationMs}ms using methods: ${data.state.methods.join(', ')}. This is deterministic evidence synthesis because AI generation was unavailable.

Limits:
${data.state.unresolved.join('; ') || 'No unresolved items, but answer is evidence-only without LLM synthesis.'}

Sources:
${data.state.findings.map(f => `${typeof f.citation === 'string' ? f.citation : (f.citation as any).label}: ${typeof f.citation === 'string' ? '#' : (f.citation as any).url}`).join('\n')}
`;
          history.push({ role: 'user', content: query }, { role: 'assistant', content: fallbackAnswer });
          renderMessage(root, query, fallbackAnswer, data.state);
          status.textContent = `Evidence retrieval complete — ${data.state.findings.length} provisions`;
          input.value = '';
          send.disabled = false;
          return;
        }
      } catch (err) {
        console.warn('research endpoint error', err);
      }

      // 3. Final fallback: static corpus + direct chat (improved scoring, not just word match)
      status.textContent = 'APIs unavailable — using static corpus with semantic scoring…';
      const findings = await retrieveStatic(query, indexUrl);
      status.textContent = `${findings.length} provisions retrieved. Reasoning with evidence…`;

      const evidence = findings.map((f,i) => `SOURCE ${i+1}\nCitation: ${typeof f.citation === 'string' ? f.citation : (f.citation as any).label}\nTitle: ${f.title || ''}\nText: ${f.text.slice(0, 1200)}`).join('\n\n');
      const system = `You are LegInfo AI, an AI research engine — not a keyword matcher. Answer only from supplied California Legislative Information corpus. Never invent citation, section, quotation, relationship, history, or legal fact. Cite inline using supplied citation label. Distinguish statutory text from analysis. If evidence does not answer question, state limitation. Reason over evidence: compare, explain, connect, investigate — do not just concatenate passages.`;

      const chatEndpoint = root.dataset.chat!;
      let answer = '';
      for (let attempt = 0; attempt < 3; attempt++) {
        try {
          const r = await fetch(chatEndpoint, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ messages: [{ role: 'system', content: system }, ...history.slice(-8), { role: 'user', content: `CORPUS EVIDENCE:\n${evidence}\n\nQUESTION:\n${query}` }] })
          });
          if (!r.ok) throw Error(`AI HTTP ${r.status}`);
          const d = await r.json() as { choices?: Array<{ message?: { content?: string } }>; response?: string; answer?: string };
          const text = d.choices?.[0]?.message?.content || d.response || d.answer;
          if (text?.trim()) { answer = text.trim(); break; }
        } catch (e) {
          if (attempt === 2) throw e;
          await sleep(600 * (attempt + 1));
        }
      }

      history.push({ role: 'user', content: query }, { role: 'assistant', content: answer });
      renderMessage(root, query, answer, { intent: 'synthesis', codes: [], subjects: [], findings, relationships: [], history: [], unresolved: [], methods: ['static-corpus','semantic-scoring','bm25-like'], provenance: { plannedSteps: 1, executedSteps: 1, durationMs: 0 } } as any);
      status.textContent = 'Research complete — static fallback with improved scoring';
      input.value = '';
    } catch (err) {
      status.textContent = `Research engine error: ${err instanceof Error ? err.message : String(err)}`;
    } finally {
      send.disabled = false;
    }
  });
});
</script>

<style>
.research-box{position:relative;isolation:isolate;overflow:hidden;margin:2.2rem 0;padding:2.25rem 1.6rem;background:linear-gradient(135deg,color-mix(in srgb,var(--sl-color-accent-low) 45%,transparent),transparent 72%),var(--sl-color-bg);border-radius:1.25rem;border:1px solid color-mix(in srgb,var(--sl-color-accent) 20%,transparent);box-shadow:0 20px 70px color-mix(in srgb,#000 12%,transparent)}
.spotlight-orb{position:absolute;z-index:-1;top:-12rem;left:22%;width:34rem;height:30rem;border-radius:50%;background:radial-gradient(circle,color-mix(in srgb,var(--sl-color-accent) 22%,transparent),transparent 68%);filter:blur(18px);pointer-events:none;animation:orb-drift 12s ease-in-out infinite alternate}
.hero-copy{position:relative;max-width:62rem}
.eyebrow{font-size:.70rem;font-weight:900;letter-spacing:.14em;color:var(--sl-color-text-accent);margin-bottom:.4rem}
.eyebrow-pulse{display:inline-block;width:.42rem;height:.42rem;margin-right:.38rem;border-radius:50%;background:var(--sl-color-text-accent);box-shadow:0 0 0 .28rem color-mix(in srgb,var(--sl-color-text-accent) 15%,transparent);vertical-align:1px}
.research-box h2{font-size:clamp(2rem,4vw,3.35rem);margin:.25rem 0;line-height:1.05;letter-spacing:-.045em}
.gradient-word{background:linear-gradient(100deg,var(--sl-color-text-accent),var(--sl-color-accent-high));-webkit-background-clip:text;background-clip:text;color:transparent}
.subhead{opacity:.78;margin:0 0 1.1rem;line-height:1.55;max-width:60rem}
.signal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem;max-width:38rem;margin:1.4rem 0 1.6rem}
.signal-card{position:relative;overflow:hidden;display:grid;grid-template-columns:auto 1fr;column-gap:.6rem;align-items:center;padding:.8rem .9rem;border:1px solid color-mix(in srgb,var(--sl-color-accent) 16%,transparent);border-radius:.8rem;background:color-mix(in srgb,var(--sl-color-bg) 72%,transparent);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}
.signal-card::before{content:"";position:absolute;inset:-1px;background:radial-gradient(180px circle at var(--mx,50%) var(--my,0%),color-mix(in srgb,var(--sl-color-accent) 22%,transparent),transparent 65%);opacity:.65;pointer-events:none}
.signal-card:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--sl-color-accent) 42%,transparent);box-shadow:0 12px 30px color-mix(in srgb,#000 12%,transparent)}
.signal-card strong,.signal-card span,.signal-card small{position:relative;z-index:1}.signal-card strong{grid-row:span 2;font-size:.72rem;color:var(--sl-color-text-accent)}.signal-card span{font-size:.82rem;font-weight:800}.signal-card small{font-size:.68rem;opacity:.62}
.conversation{display:grid;gap:.9rem;max-height:52rem;overflow:auto;margin:1rem 0;padding-right:.4rem}
