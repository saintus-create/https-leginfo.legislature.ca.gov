.message.user{background:color-mix(in srgb,var(--sl-color-accent-low) 42%,var(--sl-color-bg));border:1px solid color-mix(in srgb,var(--sl-color-accent) 18%,transparent)}
.role{font-size:.68rem;font-weight:800;letter-spacing:.11em;opacity:.7;margin-bottom:.35rem;text-transform:uppercase}
.answer{white-space:pre-wrap;word-break:break-word}
.research-box form{display:flex;gap:.65rem;margin-top:.6rem}
.research-box input{flex:1;min-width:0;padding:.95rem 1.05rem;border:0;border-radius:.7rem;background:var(--sl-color-bg);color:var(--sl-color-text);font:inherit;box-shadow:0 10px 36px color-mix(in srgb,#000 14%,transparent)}
.research-box button{padding:.95rem 1.3rem;border:0;border-radius:.7rem;background:var(--sl-color-accent);color:var(--sl-color-white);font:inherit;font-weight:800;cursor:pointer;box-shadow:0 8px 20px color-mix(in srgb,var(--sl-color-accent) 30%,transparent)}
.research-box button:disabled{opacity:.5;cursor:wait}
