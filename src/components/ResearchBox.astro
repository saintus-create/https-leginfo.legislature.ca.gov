---
const chat='https://5f679b75-e58c-4cbd-8350-b2c83df8f361.search.ai.cloudflare.com/chat/completions';
const base=import.meta.env.BASE_URL;
---
<section class="research-box" data-chat={chat} data-index={`${base}data/research-index.json`} aria-labelledby="research-box-heading">
  <div class="eyebrow">LIVE AI RESEARCH ENGINE</div>
  <h2 id="research-box-heading">Ask California law</h2>
  <p class="subhead">Conversational research grounded in the California Legislative Information corpus.</p>
  <div class="conversation" data-conversation aria-live="polite"></div>
  <form data-form><input data-query type="search" placeholder="Ask about any California code or section…" autocomplete="off" required><button data-send>Research</button></form>
  <div class="status" data-status><span class="dot"></span><span data-status-text>Ready</span></div>
</section>
<script>
interface Finding{uid?:string;citation?:string;text?:string;title?:string;section?:string;lawCode?:string;sectionNum?:string}
interface Index{version:number;codes:Record<string,{name:string;sectionCount:number}>;terms:Record<string,string[]>;locations:Record<string,string>}
interface RecordItem{kind?:string;uid?:string;citation?:string;title?:string;section?:string;text?:string}
interface AIResponse{choices?:Array<{message?:{content?:string}}>;response?:string;answer?:string}
type Msg={role:'user'|'assistant';content:string}
const esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]??c));
const sleep=(ms:number)=>new Promise(r=>setTimeout(r,ms));
const tokens=(q:string)=>q.toLowerCase().match(/[a-z0-9][a-z0-9._-]{2,}/g)?.filter(x=>!['the','and','for','that','this','with','from','what','how','why','are','was','were','about','does','doesn','section','sections'].includes(x))??[];
const codeNames:Record<string,string>={BPC:'Business and Professions Code',CIV:'Civil Code',CCP:'Code of Civil Procedure',COM:'Commercial Code',CORP:'Corporations Code',EDC:'Education Code',ELEC:'Elections Code',EVID:'Evidence Code',FAM:'Family Code',FIN:'Financial Code',FGC:'Fish and Game Code',FAC:'Food and Agricultural Code',GOV:'Government Code',HNC:'Harbors and Navigation Code',HSC:'Health and Safety Code',INS:'Insurance Code',LAB:'Labor Code',MVC:'Military and Veterans Code',PEN:'Penal Code',PROB:'Probate Code',PCC:'Public Contract Code',PRC:'Public Resources Code',PUC:'Public Utilities Code',RTC:'Revenue and Taxation Code',SHC:'Streets and Highways Code',UIC:'Unemployment Insurance Code',VEH:'Vehicle Code',WAT:'Water Code',WIC:'Welfare and Institutions Code',CONS:'California Constitution'};
const parsePart=async(url:string):Promise<RecordItem[]>=>{const r=await fetch(url);if(!r.ok)throw Error(`Corpus part HTTP ${r.status}`);const text=await r.text();return text.split(/\r?\n/).filter(Boolean).flatMap(line=>{try{const x=JSON.parse(line);return x?.kind==='section'?[x]:[]}catch{return[]}})};
const retrieve=async(query:string,indexUrl:string):Promise<Finding[]>=>{const index:Index=await fetch(indexUrl).then(r=>{if(!r.ok)throw Error(`Index HTTP ${r.status}`);return r.json()});const q=tokens(query);const wanted=new Set<string>();for(const t of q)(index.terms[t]??[]).forEach(uid=>wanted.add(uid));const code=Object.entries(codeNames).find(([k,n])=>query.toLowerCase().includes(k.toLowerCase())||query.toLowerCase().includes(n.toLowerCase()));const parts=new Set<string>();for(const uid of wanted){const p=index.locations[uid];if(p)parts.add(p)}if(code&&!parts.size){for(const uid of Object.keys(index.locations)){if(uid.startsWith(`${code[0]}:`)){const p=index.locations[uid];if(p)parts.add(p);if(parts.size>=4)break}}}if(!parts.size)throw Error('No indexed corpus candidates.');const base=indexUrl.replace(/\/data\/research-index\.json$/,'/data/law/');const records=(await Promise.all([...parts].slice(0,8).map(p=>parsePart(`${base}${p}`)))).flat();const scored=records.map(x=>{const hay=`${x.title??''} ${x.text??''}`.toLowerCase();const score=q.reduce((n,t)=>n+(hay.match(new RegExp(`\\b${t.replace(/[.*+?^${}()|[\\]\\\\]/g,'\\\\$&')}\\b`,'g'))?.length??0),0)+(q.length&&hay.includes(query.toLowerCase())?10:0);return{x,score}}).filter(x=>x.score>0).sort((a,b)=>b.score-a.score).slice(0,12).map(({x})=>({uid:x.uid,citation:x.citation,title:x.title,section:x.section,text:x.text,lawCode:code?.[0],sectionNum:x.section}));if(!scored.length)throw Error('No responsive statutory text found.');return scored};
const callAI=async(endpoint:string,messages:Array<{role:string;content:string}>):Promise<string>=>{let last='AI request failed';for(let attempt=0;attempt<3;attempt++){try{const r=await fetch(endpoint,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({messages})});if(!r.ok)throw Error(`AI HTTP ${r.status}`);const d=await r.json() as AIResponse;const text=d.choices?.[0]?.message?.content||d.response||d.answer;if(text?.trim())return text.trim();throw Error('AI returned no answer.')}catch(e){last=e instanceof Error?e.message:String(e);if(attempt<2)await sleep(700*(attempt+1))}}throw Error(last)};
const render=(root:HTMLElement,user:string,answer:string,findings:Finding[])=>{const c=root.querySelector<HTMLElement>('[data-conversation]')!;const u=document.createElement('div');u.className='message user';u.innerHTML=`<div class="role">YOU</div><div>${esc(user)}</div>`;c.append(u);const a=document.createElement('div');a.className='message assistant';a.innerHTML=`<div class="role">LEGINFO AI</div><div class="answer">${esc(answer)}</div>${findings.length?`<details open><summary>${findings.length} corpus sources retrieved</summary>${findings.map(f=>`<div class="source"><strong>${esc(f.citation||f.uid)}</strong>${f.title?`<span>${esc(f.title)}</span>`:''}<p>${esc(f.text)}</p></div>`).join('')}</details>`:''}`;c.append(a);a.scrollIntoView({block:'nearest'});return a};
document.querySelectorAll<HTMLElement>('.research-box').forEach(root=>{const form=root.querySelector<HTMLFormElement>('[data-form]')!,input=root.querySelector<HTMLInputElement>('[data-query]')!,send=root.querySelector<HTMLButtonElement>('[data-send]')!,status=root.querySelector<HTMLElement>('[data-status-text]')!,indexUrl=root.dataset.index!,endpoint=root.dataset.chat!;const history:Msg[]=[];form.addEventListener('submit',async e=>{e.preventDefault();const query=input.value.trim();if(!query||send.disabled)return;send.disabled=true;status.textContent='Retrieving primary-source provisions…';try{let findings:Finding[]=[];try{const r=await fetch(`${location.pathname.replace(/\\/$/,'')}/api/research`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({query,messages:history.slice(-8)})});if(r.ok){const d=await r.json();findings=d.state?.findings??[];if(d.answer){history.push({role:'user',content:query},{role:'assistant',content:d.answer});render(root,query,d.answer,findings);status.textContent='Research complete';input.value='';send.disabled=false;return}}}catch{}
findings=await retrieve(query,indexUrl);status.textContent=`${findings.length} statutory provisions retrieved. Reasoning…`;const evidence=findings.map((f,i)=>`SOURCE ${i+1}\nCitation: ${f.citation||f.uid}\nTitle: ${f.title||''}\nText: ${f.text||''}`).join('\n\n');const system=`You are LegInfo AI, an interactive California legislative research engine. Answer only from the supplied California Legislative Information corpus. Never invent a citation, section, quotation, relationship, legislative history, or legal fact. Cite substantive propositions inline using the supplied citation. Distinguish statutory text from analysis. If the retrieved evidence does not answer the question, state that limitation. You are a research engine, not a generic text synthesizer.`;const messages=[{role:'system',content:system},...history.slice(-8),{role:'user',content:`CORPUS EVIDENCE:\n${evidence}\n\nQUESTION:\n${query}`}];const answer=await callAI(endpoint,messages);history.push({role:'user',content:query},{role:'assistant',content:answer});render(root,query,answer,findings);status.textContent='Research complete';input.value=''}catch(err){status.textContent=`Research engine retry required: ${err instanceof Error?err.message:String(err)}`}finally{send.disabled=false}})});
</script>
<style>
.research-box{margin:2rem 0;padding:1.5rem 0;background:linear-gradient(135deg,color-mix(in srgb,var(--sl-color-accent-low) 30%,transparent),transparent 65%);border-radius:1rem}.eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.12em;color:var(--sl-color-text-accent)}.research-box h2{font-size:clamp(1.6rem,3vw,2.3rem);margin:.3rem 0}.subhead{opacity:.72;margin:0 0 1rem}.conversation{display:grid;gap:.8rem;max-height:46rem;overflow:auto;margin:1rem 0}.message{padding:1rem 1.1rem;border-radius:.8rem;background:color-mix(in srgb,var(--sl-color-bg) 88%,var(--sl-color-accent-low));line-height:1.65}.message.user{background:color-mix(in srgb,var(--sl-color-accent-low) 38%,var(--sl-color-bg))}.role{font-size:.65rem;font-weight:800;letter-spacing:.1em;opacity:.6;margin-bottom:.3rem}.answer{white-space:pre-wrap}.research-box form{display:flex;gap:.6rem}.research-box input{flex:1;min-width:0;padding:.9rem 1rem;border:0;border-radius:.65rem;background:var(--sl-color-bg);color:var(--sl-color-text);font:inherit;box-shadow:0 8px 30px color-mix(in srgb,#000 12%,transparent)}.research-box button{padding:.9rem 1.2rem;border:0;border-radius:.65rem;background:var(--sl-color-accent);color:var(--sl-color-white);font:inherit;font-weight:800;cursor:pointer}.research-box button:disabled{opacity:.5;cursor:wait}.status{display:flex;align-items:center;gap:.5rem;margin:.75rem 0;font-size:.82rem;opacity:.72}.dot{width:.45rem;height:.45rem;border-radius:50%;background:currentColor}.source{padding:.8rem 0;border-top:1px solid color-mix(in srgb,var(--sl-color-gray-5) 45%,transparent)}.source span{display:block;font-size:.8rem;opacity:.65}.source p{white-space:pre-wrap;margin:.4rem 0 0}.message details{margin-top:1rem}.message summary{cursor:pointer;font-weight:700}@media(max-width:700px){.research-box form{flex-direction:column}}
</style>
