.message details{margin-top:1.1rem;background:color-mix(in srgb,var(--sl-color-bg) 60%,transparent);border-radius:.6rem;padding:.2rem .8rem}
.message summary{cursor:pointer;font-weight:700;padding:.6rem 0;list-style:none}
.message summary::-webkit-details-marker{display:none}
.capabilities{margin-top:1rem;padding:.8rem 1rem;background:color-mix(in srgb,var(--sl-color-bg) 75%,transparent);border-radius:.7rem;border:1px dashed color-mix(in srgb,var(--sl-color-accent) 20%,transparent)}
.capabilities summary{cursor:pointer;font-weight:700;font-size:.9rem}
.capabilities ul{margin:.6rem 0 0 1.1rem;padding:0;display:grid;gap:.35rem;font-size:.86rem;opacity:.85;line-height:1.5}
@keyframes orb-drift{from{transform:translate3d(-4%,0,0) scale(.96)}to{transform:translate3d(8%,5%,0) scale(1.06)}}
