.rels{display:grid;gap:.4rem;margin:.5rem 0}
.rel{font-size:.85rem;padding:.4rem .6rem;background:color-mix(in srgb,var(--sl-color-bg) 70%,var(--sl-color-gray-6));border-radius:.4rem}
.rel code{font-weight:700}
.rel span{opacity:.7;margin-left:.4rem}
.history{padding:.4rem 0;border-top:1px solid color-mix(in srgb,var(--sl-color-gray-5) 30%,transparent);font-size:.9rem}
