---
const chat='https://5f679b75-e58c-4cbd-8350-b2c83df8f361.search.ai.cloudflare.com/chat/completions';
const base=import.meta.env.BASE_URL;
---
<section class="research-box" data-chat={chat} data-index={`${base}data/research-index.json`} aria-labelledby="research-box-heading"><div class="eyebrow">AI legislative research</div><h2 id="research-box-heading">Ask the California statutes</h2><p>Ask a question in plain language. Research can compare codes, trace statutory relationships, examine history, and show the evidence behind the answer.</p><form data-form><input data-query type="search" placeholder="What do Family Code and Government Code have in common?" autocomplete="off" required><button>Research</button></form><div data-status aria-live="polite">Ready.</div><article data-answer hidden></article></section>
<script>
interface Finding{citation?:string;text?:string;wordCount?:number;charCount?:number;section?:string}
interface R{answer?:string;state?:{intent?:string;findings?:Array<Finding>;unresolved?:string[]}}
interface C{choices?:Array<{message?:{content?:string}}>;answer?:string;response?:string}
interface IndexCode{name:string;sectionCount:number;longestSentenceByWords?:Finding;longestSentenceByChars?:Finding}
interface Index{version:number;codes:Record<string,IndexCode>}
const esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]??c));
const codeForQuery=(query:string,index:Index)=>{const q=query.toLowerCase();for(const [abbr,code] of Object.entries(index.codes)){if(q.includes(code.name.toLowerCase())||new RegExp(`\\b${abbr.toLowerCase()}\\b`).test(q))return [abbr,code] as const}return null};
const deterministic=async(query:string,indexUrl:string):Promise<{answer:string;finding:Finding}|null>=>{if(!/\blongest\s+sentence\b/i.test(query))return null;const index:Index=await fetch(indexUrl).then(r=>{if(!r.ok)throw Error(`Index HTTP ${r.status}`);return r.json()});const match=codeForQuery(query,index);if(!match)return null;const [abbr,code]=match;const finding=code.longestSentenceByWords;if(!finding?.text)return null;const chars=code.longestSentenceByChars;const answer=`The longest sentence in the ${code.name} is in ${finding.citation}, measured by word count. It contains ${finding.wordCount?.toLocaleString()??'an unknown number of'} words and ${finding.charCount?.toLocaleString()??'an unknown number of'} characters.\n\n${finding.text}${chars&&chars.citation!==finding.citation?`\n\nBy character count, the longest sentence is in ${chars.citation}, at ${chars.charCount?.toLocaleString()??'an unknown number of'} characters.`:''}\n\nThis result is computed directly from the corpus rather than inferred by the language model.`;return {answer,finding}};
document.querySelectorAll<HTMLElement>('.research-box').forEach(root=>{const form=root.querySelector<HTMLFormElement>('[data-form]')!,q=root.querySelector<HTMLInputElement>('[data-query]')!,s=root.querySelector<HTMLElement>('[data-status]')!,a=root.querySelector<HTMLElement>('[data-answer]')!,chat=root.dataset.chat!,indexUrl=root.dataset.index!;form.addEventListener('submit',async e=>{e.preventDefault();const text=q.value.trim();if(!text)return;s.textContent='Researching…';a.hidden=true;try{const exact=await deterministic(text,indexUrl);if(exact){a.innerHTML=`<div class="answer-text">${esc(exact.answer)}</div><details open><summary>Corpus evidence</summary><div class="evidence"><strong>${esc(exact.finding.citation)}</strong><div>${esc(exact.finding.text)}</div></div></details>`;a.hidden=false;s.textContent='Research complete.';return}let data:R|C;const r=await fetch('/api/research',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({query:text})});if(r.ok)data=await r.json();else{const x=await fetch(chat,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({messages:[{role:'user',content:text}]})});if(!x.ok)throw Error(`Research HTTP ${x.status}`);data=await x.json()}const answer='answer'in data?data.answer:data.choices?.[0]?.message?.content||data.response||'';const state='state'in data?data.state:undefined;a.innerHTML=`<div class="answer-text">${esc(answer)}</div>${state?.findings?.length?`<details><summary>Evidence (${state.findings.length})</summary>${state.findings.slice(0,20).map(x=>`<div class="evidence"><strong>${esc(x.citation)}</strong><div>${esc(x.text)}</div></div>`).join('')}</details>`:''}${state?.unresolved?.length?`<details><summary>Limits</summary>${state.unresolved.map(x=>`<div>${esc(x)}</div>`).join('')}</details>`:''}`;a.hidden=false;s.textContent='Research complete.'}catch(x){s.textContent=`Research unavailable: ${x instanceof Error?x.message:String(x)}`}})});
</script>
<style>
.research-box{margin:2rem 0;padding:1.5rem;background:color-mix(in srgb,var(--sl-color-accent-low) 28%,var(--sl-color-bg));border-radius:.8rem}.eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--sl-color-text-accent)}.research-box h2{margin:.25rem 0}.research-box form{display:flex;gap:.6rem;margin-top:1rem}.research-box input{flex:1;min-width:0;padding:.8rem;border:0;border-radius:.4rem;background:var(--sl-color-bg);color:var(--sl-color-text);font:inherit}.research-box button{padding:.8rem 1.1rem;border:0;border-radius:.4rem;background:var(--sl-color-accent);color:var(--sl-color-white);font:inherit;font-weight:700;cursor:pointer}.research-box [data-status]{margin:.8rem 0;color:var(--sl-color-gray-2);font-size:.9rem}.answer-text{white-space:pre-wrap;line-height:1.7;margin:1rem 0}.evidence{border-top:1px solid var(--sl-color-gray-5);padding:.8rem 0}.evidence strong{color:var(--sl-color-text-accent)}.evidence div{white-space:pre-wrap;margin-top:.3rem}@media(max-width:700px){.research-box form{flex-direction:column}}
</style>
