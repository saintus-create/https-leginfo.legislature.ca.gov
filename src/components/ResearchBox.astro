---
const chat='https://5f679b75-e58c-4cbd-8350-b2c83df8f361.search.ai.cloudflare.com/chat/completions';
const base=import.meta.env.BASE_URL;
---
<section class="research-box" data-chat={chat} data-index={`${base}data/research-index.json`} aria-labelledby="research-box-heading"><div class="eyebrow">AI legislative research</div><h2 id="research-box-heading">Ask the California statutes</h2><p>Ask a question in plain language. The California Legislative Information corpus is checked first, then AI explains the retrieved evidence.</p><form data-form><input data-query type="search" placeholder="What do Family Code and Government Code have in common?" autocomplete="off" required><button>Research</button></form><div data-status aria-live="polite">Ready.</div><article data-answer hidden></article></section>
<script>
interface Finding{citation?:string;text?:string;wordCount?:number;charCount?:number;section?:string}
interface R{answer?:string;state?:{intent?:string;findings?:Array<Finding>;unresolved?:string[]}}
interface C{choices?:Array<{message?:{content?:string}}>;answer?:string;response?:string}
interface IndexCode{name:string;sectionCount:number;longestSentenceByWords?:Finding;longestSentenceByChars?:Finding}
interface Index{version:number;codes:Record<string,IndexCode>}
const esc=(v:unknown)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]??c));
const codeForQuery=(query:string,index:Index)=>{const q=query.toLowerCase();for(const [abbr,code] of Object.entries(index.codes)){if(q.includes(code.name.toLowerCase())||new RegExp(`\\b${abbr.toLowerCase()}\\b`).test(q))return [abbr,code] as const}return null};
const deterministic=async(query:string,indexUrl:string):Promise<{answer:string;finding:Finding;code:IndexCode}|null>=>{if(!/\blongest\s+sentence\b/i.test(query))return null;const index:Index=await fetch(indexUrl).then(r=>{if(!r.ok)throw Error(`Index HTTP ${r.status}`);return r.json()});const match=codeForQuery(query,index);if(!match)return null;const [,code]=match;const finding=code.longestSentenceByWords;if(!finding?.text)return null;const chars=code.longestSentenceByChars;const answer=`The corpus identifies ${finding.citation} as the longest sentence in the ${code.name} by word count (${finding.wordCount?.toLocaleString()??'an unknown number of'} words, ${finding.charCount?.toLocaleString()??'an unknown number of'} characters).\\n\\n${finding.text}${chars&&chars.citation!==finding.citation?`\\n\\nBy character count, the longest sentence is in ${chars.citation}, at ${chars.charCount?.toLocaleString()??'an unknown number of'} characters.`:''}`;return {answer,finding,code}};
const askAIWithEvidence=async(query:string,exact:{answer:string;finding:Finding;code:IndexCode})=>{const evidence=`Source: California Legislative Information corpus.\\nCode: ${exact.code.name}.\\nCitation: ${exact.finding.citation}.\\nWord count: ${exact.finding.wordCount}.\\nCharacter count: ${exact.finding.charCount}.\\nStatutory text: ${exact.finding.text}`;const prompt=`Answer this California legislative research question using ONLY the corpus evidence below. Do not invent citations or facts. You may explain the result, but preserve the citation and statutory text exactly.\\n\\nCORPUS EVIDENCE\\n${evidence}\\n\\nQUESTION\\n${query}`;const r=await fetch(chat,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({messages:[{role:'user',content:prompt}]})});if(!r.ok)throw Error(`AI HTTP ${r.status}`);const data=await r.json() as C;return data.choices?.[0]?.message?.content||data.answer||data.response||exact.answer};
document.querySelectorAll<HTMLElement>('.research-box').forEach(root=>{const form=root.querySelector<HTMLFormElement>('[data-form]')!,q=root.querySelector<HTMLInputElement>('[data-query]')!,s=root.querySelector<HTMLElement>('[data-status]')!,a=root.querySelector<HTMLElement>('[data-answer]')!,chat=root.dataset.chat!,indexUrl=root.dataset.index!;form.addEventListener('submit',async e=>{e.preventDefault();const text=q.value.trim();if(!text)return;s.textContent='Searching the California corpus…';a.hidden=true;try{const r=await fetch('/api/research',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({query:text})});if(r.ok){const data=await r.json() as R|C;const answer='answer'in data?data.answer:data.choices?.[0]?.message?.content||data.response||'';const state='state'in data?data.state:undefined;a.innerHTML=`<div class="answer-text">${esc(answer)}</div>${state?.findings?.length?`<details open><summary>Corpus evidence (${state.findings.length})</summary>${state.findings.slice(0,20).map(x=>`<div class="evidence"><strong>${esc(x.citation)}</strong><div>${esc(x.text)}</div></div>`).join('')}</details>`:''}`;a.hidden=false;s.textContent='Research complete.';return}const exact=await deterministic(text,indexUrl);if(exact){s.textContent='Corpus match found. Asking AI to explain the retrieved evidence…';const answer=await askAIWithEvidence(text,exact);a.innerHTML=`<div class="answer-text">${esc(answer)}</div><details open><summary>Corpus evidence</summary><div class="evidence"><strong>${esc(exact.finding.citation)}</strong><div>${esc(exact.finding.text)}</div><small>${esc(exact.code.name)} · ${exact.finding.wordCount?.toLocaleString()??'?'} words · ${exact.finding.charCount?.toLocaleString()??'?'} characters</small></div></details>`;a.hidden=false;s.textContent='Research complete.';return}const x=await fetch(chat,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({messages:[{role:'user',content:text}]})});if(!x.ok)throw Error(`Research HTTP ${x.status}`);const data=await x.json() as C;const answer=data.choices?.[0]?.message?.content||data.answer||data.response||'';a.innerHTML=`<div class="answer-text">${esc(answer)}</div><p class="notice">No matching corpus retrieval was available for this question.</p>`;a.hidden=false;s.textContent='Research complete.'}catch(x){s.textContent=`Research unavailable: ${x instanceof Error?x.message:String(x)}`}})});
</script>
<style>
.research-box{margin:2rem 0;padding:1.5rem;background:color-mix(in srgb,var(--sl-color-accent-low) 28%,var(--sl-color-bg));border-radius:.8rem}.eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--sl-color-text-accent)}.research-box h2{margin:.25rem 0}.research-box form{display:flex;gap:.6rem;margin-top:1rem}.research-box input{flex:1;min-width:0;padding:.8rem;border:0;border-radius:.4rem;background:var(--sl-color-bg);color:var(--sl-color-text);font:inherit}.research-box button{padding:.8rem 1.1rem;border:0;border-radius:.4rem;background:var(--sl-color-accent);color:var(--sl-color-white);font:inherit;font-weight:700;cursor:pointer}.research-box [data-status]{margin:.8rem 0;color:var(--sl-color-gray-2);font-size:.9rem}.answer-text{white-space:pre-wrap;line-height:1.7;margin:1rem 0}.evidence{border-top:1px solid var(--sl-color-gray-5);padding:.8rem 0}.evidence strong{color:var(--sl-color-text-accent)}.evidence div{white-space:pre-wrap;margin-top:.3rem}.evidence small{display:block;margin-top:.5rem;opacity:.7}.notice{font-size:.85rem;opacity:.7}@media(max-width:700px){.research-box form{flex-direction:column}}
</style>
